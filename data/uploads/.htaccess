# Permite doar imagini in uploads; blocheaza orice script
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg)$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg)$">
        Allow from all
    </FilesMatch>
</IfModule>
# Dezactiveaza executia PHP in uploads
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
