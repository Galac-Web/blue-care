# Copiaza in .env si completeaza valorile

# RapidAPI — Auto Parts Catalog (fallback cand lipseste OEM)
RAPIDAPI_AUTOPARTS_KEY=2c0e671600mshfc07ac922f4b2afp1d7684jsn7601320fe290

# Stealth browser (nodriver) — inlocuieste scrape.do la scanarea produselor.
# Ruleaza local prin robot/stealth_fetch.py + robot/stealth-browser-mcp/venv.
STEALTH_FETCH_ENABLED=1
# 1 = fereastra vizibila (trece mai usor de Cloudflare), 0 = headless
STEALTH_HEADFUL=1
STEALTH_WAIT=6
STEALTH_TIMEOUT=60
# Cat asteapta listingul dupa Cloudflare; daca nu apare => 0 rezultate, trece la OEM-ul urmator
STEALTH_SELECTOR_TIMEOUT=15
# Optional: cale explicita catre python-ul din venv
# STEALTH_PYTHON=E:\laragon\www\blu-car.ro\robot\stealth-browser-mcp\venv\Scripts\python.exe

# scrape.do — fallback daca stealth esueaza (optional)
SCRAPE_DO_TOKEN=

# Autodoc: importa toate variantele (1) sau doar prima (0)
AUTODOC_IMPORT_ALL=1
# Filtre optionale (gol = fara limita)
# AUTODOC_BRANDS=MIRAGLIO,BLIC
# AUTODOC_MIN_PRICE=0
# AUTODOC_MAX_PRICE=0
# AUTODOC_IN_STOCK_ONLY=0

# Robot Python → site (OBLIGATORIU aceeasi valoare in robot/robot_config.json)
ROBOT_API_KEY=19921705

# Robot Furnizori GBG (robot1.py, port 5000) — Monitor Robot
ROBOT_FURNIZORI_URL=http://127.0.0.1:5000
# Tunnel HTTPS (ngrok) — OBLIGATORIU dacă admin e pe blu-car.ro iar robotul rulează pe PC local:
# ngrok http 5000  →  copiază URL-ul HTTPS aici
# ROBOT_FURNIZORI_TUNNEL_URL=https://xxxx.ngrok-free.app
# Robot PieseAuto (robot_pieseauto.py, port 5007) — PieseAuto Robot
ROBOT_PIESEAUTO_URL=http://127.0.0.1:5007
ROBOT_PIESEAUTO_PORT=5007
# ROBOT_PIESEAUTO_TUNNEL_URL=https://yyyy.ngrok-free.app
# Alias vechi
ROBOT_BASE_URL=http://127.0.0.1:5000

# Pornire automata ambele roboti (1=da, 0=nu) — doar pentru URL-uri locale
ROBOT_AUTO_START=1
# Optional: cale python daca nu e in PATH
# ROBOT_PYTHON=python

# MySQL dedicat Blue-Car (NU folosi agent_db — e pentru aibotpiese)
DB_HOST=localhost
DB_NAME=blu_car_db
DB_USER=blu_car
DB_PASS=BluCar2026!
# Instalare: deschide prd/install_blu_car_db.php sau rulează prd/install_blu_car_db.sql
# DB_INSTALL_ROOT_USER=root
# DB_INSTALL_ROOT_PASS=

# Optional: protejeaza import-catalog.php
# IMPORT_ACCESS_KEY=19921705

# Magazin: 0 = doar conturi din admin (Clienți site), 1 = înregistrare publică register.php
SHOP_ALLOW_PUBLIC_REGISTER=0
# Magazin închis: 0 = catalog/coș necesită login client, 1 = browse public fără cont
SHOP_GUEST_BROWSE=0

# Ollama local — OEM normalize + traducere GR→RO când Autodoc/TecDoc nu găsesc
OLLAMA_ENABLED=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
